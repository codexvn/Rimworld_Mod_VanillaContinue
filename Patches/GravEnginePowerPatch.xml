<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- 给逆重引擎挂燃料组件：燃料默认玻璃钢（可在 Mod 设置切换为逆重板），自动加注阈值 100%
       （原版飞船燃料罐的做法，修复原 mod 沿用 30% 阈值导致燃料条停在三分之一处的问题），支持设置目标燃料量 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName='GravEngine']/comps[not(li[@Class='CompProperties_Refuelable'])]</xpath>
    <value>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>10000</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>10000</initialConfigurableTargetFuelLevel>
        <autoRefuelPercent>1</autoRefuelPercent>
        <fuelFilter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>玻璃钢</fuelLabel>
        <fuelGizmoLabel>玻璃钢</fuelGizmoLabel>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </value>
  </Operation>

  <!-- 发电组件：基础发电量 + 按燃料量提升 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName='GravEngine']/comps[not(li[@Class='VanillaContinue.CompProperties_PowerPlantGravEngine'])]</xpath>
    <value>
      <li Class="VanillaContinue.CompProperties_PowerPlantGravEngine">
        <transmitsPower>true</transmitsPower>
      </li>
    </value>
  </Operation>

</Patch>
