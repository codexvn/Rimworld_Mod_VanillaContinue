<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>VanillaContinue</AssemblyName>
    <RootNamespace>VanillaContinue</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>publish\1.7\Assemblies\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>F:\SteamLibrary\steamapps\common\RimWorld\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 1.7 起 UnityEngine.* 类型定义于游戏根目录 UnityStubs.dll -->
    <Reference Include="UnityStubs">
      <HintPath>F:\SteamLibrary\steamapps\common\RimWorld\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 组装可部署的 mod 目录：About / Patches / 预览图随构建复制到 publish -->
  <Target Name="Package" AfterTargets="Build">
    <ItemGroup>
      <MetaFiles Include="$(MSBuildProjectDirectory)\About\**\*" />
      <PatchFiles Include="$(MSBuildProjectDirectory)\Patches\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MetaFiles)" DestinationFolder="$(OutputPath)..\..\About\%(RecursiveDir)" />
    <Copy SourceFiles="@(PatchFiles)" DestinationFolder="$(OutputPath)..\..\Patches\%(RecursiveDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Preview.png" DestinationFolder="$(OutputPath)..\..\" Condition="Exists('$(MSBuildProjectDirectory)\Preview.png')" />
    <Delete Files="$(OutputPath)$(AssemblyName).pdb" ContinueOnError="true" />
  </Target>

</Project>
